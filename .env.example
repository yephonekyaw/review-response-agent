# Which LLM backend to use: "gemini" (default) or "ollama"
LLM_PROVIDER=gemini

# --- Gemini (free at https://aistudio.google.com/app/apikey) ---
GEMINI_API_KEY=your-key-here
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=text-embedding-004
# Min seconds between Gemini calls (free tier is ~10 req/min → 6.5s is safe). Set 0 to disable.
GEMINI_MIN_INTERVAL=6.5
# Max retries on 429; the provider sleeps for the server-suggested delay each time.
GEMINI_MAX_RETRIES=5

# --- Ollama fallback (only used when LLM_PROVIDER=ollama) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
